{
  "name": "new-tab-links-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "config:local": "./scripts/write-local-runtime-config.sh",
    "tips:index": "node scripts/build-tips-index.mjs",
    "demo:index": "node scripts/build-demo-index.mjs",
    "home-features:index": "node scripts/build-home-features-index.mjs",
    "crawler-files": "node scripts/build-crawler-files.mjs",
    "prestart": "npm run config:local && npm run tips:index && npm run demo:index && npm run home-features:index && npm run crawler-files",
    "start": "ng serve",
    "prebuild": "npm run tips:index && npm run demo:index && npm run home-features:index && npm run crawler-files",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@9.2.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.21",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.21",
    "marked": "^18.0.14",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.21",
    "@angular/cli": "^21.2.21",
    "@angular/compiler-cli": "^21.2.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
