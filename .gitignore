# Angular specific
/dist/
/out-tsc/
/tmp/
/coverage/
/e2e/test-output/
/.angular/
.angular/

# Node modules and dependency files
#
# package-lock.json is committed on purpose: the image is built from it with
# `npm ci`. npm 10.9.4 - the version in the pinned node:22.22.1 build image -
# crashes while resolving this dependency graph from scratch, so a build without
# the lockfile cannot install at all. See the Dockerfile's build stage.
/node_modules/
/yarn.lock

# Environment files
/.env

# Angular CLI and build artefacts
/.angular-cli.json
/.ng/

# TypeScript cache
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

.idea
# Claude local, machine-specific settings
.claude/settings.local.json

# Local compose overrides (machine-specific, may hold Google OAuth secrets)
/.env.backend.local

# Local runtime configuration for `ng serve`, e.g. pointing the dev server at the deployed
# API while stealing the real domain under mirrord. The deployed image gets its own config.json
# from the entrypoint, so this file is a developer's override and never belongs in a commit.
/public/config.json

# Local runtime configuration values for `ng serve`, from which
# scripts/write-local-runtime-config.sh generates public/config.json. Machine-
# specific, and the committed template is .env.local.example.
/.env.local

# Generated from public/content/tips/*/*.md by scripts/build-tips-index.mjs before start and build.
/public/content/tips/index.json
/public/content/demo/index.json
