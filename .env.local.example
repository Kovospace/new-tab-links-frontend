# ---------------------------------------------------------------------------
# Local runtime configuration for `ng serve`. Copy to `.env.local`, which is
# gitignored, and edit there:
#
#     cp .env.local.example .env.local
#
# `npm start` runs scripts/write-local-runtime-config.sh before the dev server
# and turns these into public/config.json — the file main.ts fetches before
# Angular boots. The variable names are the same ones the container's entrypoint
# reads, so what is written here is what a deployment would set on the Pod.
#
# Variables already present in the environment win over this file, so
#
#     infisical run -- npm start
#
# injects them without this file needing to exist at all.
#
# Nothing here is a secret. Every value is served to every visitor in plain text
# inside config.json. A real secret must never be added to this file.
# ---------------------------------------------------------------------------

# Where the API lives.
#
# Empty means "same origin", which routes every /api call through the dev
# server's proxy (proxy.conf.json) to the deployed backend. That is what keeps
# localhost out of CORS: the deployed backend's allow-list holds only
# https://tabilinks.app, so a direct cross-origin call from :5173 is refused.
#
# Set it to http://localhost:8080 instead when running the backend yourself with
# `docker compose up -d` — that backend allows http://localhost:5173 by default,
# so it needs no proxy.
NEWTABLINKS_BACKEND_BASE_URL=

# Shared key admitting this site to GET /api/v1/auth/username-existence — the
# live "is this username taken?" check on the registration form, and the only
# endpoint that demands it. Without it that one call answers 403 and the form
# falls back to no live feedback; nothing else on the site is affected.
#
# It must match the backend's own FRONTEND_API_KEY byte for byte, so the value
# to put here is whichever one the backend you are pointing at was started with.
# Leave it empty and the site never makes the call at all, which is the correct
# behaviour when the backend has no key configured either.
NEWTABLINKS_FRONTEND_API_KEY=

# The rest only matter when you are working on the pages that use them.
# NEWTABLINKS_WEB_CLIENT_DEVICE_NAME=NewTabLinks website
# NEWTABLINKS_USERNAME_CHECK_DEBOUNCE_MS=250
# NEWTABLINKS_CHROME_WEB_STORE_URL=
